{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Goshomi tour",
  "type": "object",
  "required": [
    "schemaVersion",
    "repository",
    "nodes",
    "edges",
    "chapters",
    "sources"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "repository": {
      "type": "object",
      "required": [
        "name",
        "description",
        "technologies",
        "revision",
        "generatedAt",
        "snapshot"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "technologies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "generatedAt": {
          "type": "string",
          "minLength": 1
        },
        "snapshot": {
          "type": "string",
          "minLength": 1
        },
        "gitFingerprint": {
          "type": "string",
          "minLength": 64,
          "description": "SHA-256 snapshot captured before semantic analysis."
        },
        "threatReviewPolicy": {
          "enum": [
            "owasp-genai-2026-v1",
            "security-path-review-2026-v2",
            "self-contained-remediation-2026-v3"
          ],
          "description": "Agent attestation of the completed security review workflow."
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "kind",
          "description",
          "refs",
          "position"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/definitions/ref"
            }
          },
          "position": {
            "type": "object",
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "target",
          "label"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "chapters": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "eyebrow",
          "intro",
          "steps"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "eyebrow": {
            "type": "string",
            "minLength": 1
          },
          "intro": {
            "type": "string",
            "minLength": 1
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "title",
                "body",
                "node",
                "refs",
                "status"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "body": {
                  "type": "string",
                  "minLength": 1
                },
                "node": {
                  "type": "string",
                  "minLength": 1
                },
                "refs": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/definitions/ref"
                  }
                },
                "status": {
                  "enum": [
                    "verified",
                    "interpretation",
                    "needs verification"
                  ]
                },
                "input": {
                  "type": "string",
                  "minLength": 1
                },
                "output": {
                  "type": "string",
                  "minLength": 1
                },
                "risk": {
                  "type": "object",
                  "required": [
                    "asset",
                    "boundary",
                    "scenario",
                    "consequence",
                    "control",
                    "mitigation",
                    "confidence"
                  ],
                  "properties": {
                    "asset": {
                      "type": "string",
                      "minLength": 1
                    },
                    "boundary": {
                      "type": "string",
                      "minLength": 1
                    },
                    "scenario": {
                      "type": "string",
                      "minLength": 1
                    },
                    "consequence": {
                      "type": "string",
                      "minLength": 1
                    },
                    "control": {
                      "type": "string",
                      "minLength": 1
                    },
                    "mitigation": {
                      "type": "string",
                      "minLength": 1
                    },
                    "confidence": {
                      "type": "string",
                      "minLength": 1
                    },
                    "attackPath": {
                      "type": "array",
                      "minItems": 2,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "description": "Ordered node IDs representing a plausible, evidence-based attack path; each pair must correspond to a recorded architecture connection."
                    },
                    "assessment": {
                      "type": "object",
                      "required": [
                        "level",
                        "rationale",
                        "references"
                      ],
                      "properties": {
                        "level": {
                          "enum": [
                            "High",
                            "Medium",
                            "Low",
                            "Needs verification"
                          ]
                        },
                        "rationale": {
                          "type": "string",
                          "minLength": 1
                        },
                        "references": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "required": [
                              "title",
                              "url"
                            ],
                            "properties": {
                              "title": {
                                "type": "string",
                                "minLength": 1
                              },
                              "url": {
                                "type": "string",
                                "minLength": 1
                              }
                            }
                          }
                        }
                      }
                    },
                    "mitigationPrompt": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "finding": {
                  "type": "object",
                  "required": ["status", "severity", "issue", "reachability", "impact", "fixExplanation", "fixCode", "fixPrompt"],
                  "properties": {
                    "status": {"enum": ["confirmed", "needs verification"]},
                    "severity": {"enum": ["Critical", "High", "Medium", "Low", "Informational", "Needs verification"]},
                    "issue": {"type": "string", "minLength": 1},
                    "reachability": {"type": "string", "minLength": 1},
                    "impact": {"type": "string", "minLength": 1},
                    "fixExplanation": {"type": "string", "minLength": 1},
                    "fixCode": {"type": "string", "minLength": 1},
                    "fixPatch": {"type": "string", "minLength": 1, "description": "Optional reviewable unified Git patch with repo-relative path and context from the analyzed snapshot."},
                    "fixPrompt": {"type": "string", "minLength": 1}
                  }
                }
              }
            }
          }
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "content",
          "sha256"
        ],
        "properties": {
          "content": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "definitions": {
    "ref": {
      "type": "object",
      "required": [
        "path",
        "start",
        "end"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "integer",
          "minimum": 1
        },
        "end": {
          "type": "integer",
          "minimum": 1
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
